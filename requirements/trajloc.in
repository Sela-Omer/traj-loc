# TrajLoc's direct dependencies (the trajloc environment's spec).
# requirements/trajloc.txt is the full pinned lock, frozen from the environment
# the release ran in. A new lock from this file (a new environment: check that
# the released models' outputs are unchanged with it before replacing the lock):
#   uv pip compile --index-strategy unsafe-best-match --python-version 3.10 \
#       --python-platform x86_64-manylinux2014 --emit-index-url requirements/trajloc.in
# flash-attn is installed separately (it builds against torch): scripts/env/install.sh.
--extra-index-url https://download.pytorch.org/whl/cu124
